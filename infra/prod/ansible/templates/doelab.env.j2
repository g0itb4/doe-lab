# Rendered to /etc/doelab/doelab.env by the playbook: root:deploy, 0640.
# Group-readable because scripts/deploy.sh sources it to run migrations as the
# deploy user. vars.yml is the canonical source of these values: change it
# there and re-run the playbook, not here. Every knob is read by
# apps/api/internal/config/config.go, which the API, the engine and the
# simulated devices share.

# The hardening switch: request logging off, gRPC reflection off, and no
# development default accepted for a secret. config.go treats an unset value
# as production too, so this line is documentation.
DOELAB_ENV=production

# Loopback only: the listener is plaintext and must only be reachable through
# Caddy, whatever the firewall happens to say.
HOST=127.0.0.1
PORT=3100
# Where the engine and the devices find the API: on this host, not through
# the edge.
API_URL=http://127.0.0.1:3100

# Local Postgres over loopback: sslmode=disable is correct here because the
# connection never leaves the box.
DATABASE_URL=postgres://doelab:{{ doelab_db_password }}@localhost:5432/doelab?sslmode=disable
DB_MAX_CONNS=16
REQUEST_TIMEOUT_MS=15000

# One token for each scope, and a secret from which each site's device token
# is derived. At least 24 characters each; `openssl rand -hex 32`.
ENGINE_TOKEN={{ engine_token }}
OPERATOR_TOKEN={{ operator_token }}
DEVICE_TOKEN_SECRET={{ device_token_secret }}

# The demo clock: feeder time runs this many times faster than the wall
# clock, from the anchor. See "The clock" in infra/prod/README.md before
# changing either on a server that has data.
DEMO_CLOCK_SPEED={{ demo_clock_speed }}
DEMO_CLOCK_ANCHOR={{ demo_clock_anchor }}

# How much history is kept, in days of feeder time. These bound the size of
# the database.
RETENTION_READINGS_DAYS={{ retention_readings_days }}
RETENTION_ENVELOPES_DAYS={{ retention_envelopes_days }}
RETENTION_ALERTS_DAYS={{ retention_alerts_days }}

# Calls a second, and in a burst, from one client address. The simulated
# devices all come from this host.
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=400

# The object store, for exports and the raw datasets of an import.
# DigitalOcean Spaces speaks S3 with virtual-hosted addresses.
S3_ENDPOINT={{ s3_endpoint }}
S3_REGION={{ s3_region }}
S3_BUCKET={{ s3_bucket }}
S3_ACCESS_KEY_ID={{ s3_access_key_id }}
S3_SECRET_ACCESS_KEY={{ s3_secret_access_key }}
S3_PATH_STYLE=false

# Metrics for a scraper on this host. config.go refuses anything but loopback
# in production.
METRICS_ADDR=127.0.0.1:9464
OTEL_EXPORTER_OTLP_ENDPOINT={{ otlp_endpoint }}

# The assistant. Empty turns it off.
ANTHROPIC_API_KEY={{ anthropic_api_key }}

# DOELAB_VERSION is deliberately absent: scripts/deploy.sh writes it to
# /srv/doelab/current/version.env, which the systemd units also read.
