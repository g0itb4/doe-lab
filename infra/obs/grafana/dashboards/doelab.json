      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(doelab_envelope_dispatch_latency_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
