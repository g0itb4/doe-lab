{
  "name": "doelab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "//trustedDependencies": "packages permitted to run install scripts (native builds, binary downloads).",
  "trustedDependencies": [
    "@bufbuild/buf",
    "esbuild"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate": "buf generate",
    "lint:proto": "buf lint",
    "dev": "turbo run dev"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@types/node": "^26.1.1",
    "prettier": "^3",
    "prettier-plugin-svelte": "^4",
    "prettier-plugin-tailwindcss": "^0.8",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2"
  }
}
