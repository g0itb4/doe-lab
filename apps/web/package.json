{
  "name": "@doelab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//": "The operator UI: SvelteKit with adapter-static, no SSR server. The API is reached at /rpc.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "test": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@doelab/gen": "workspace:*",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@7",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-istanbul": "^4",
    "playwright": "^1.62.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.1.5",
    "vitest": "^4",
    "vitest-browser-svelte": "^3.0.0"
  }
}
