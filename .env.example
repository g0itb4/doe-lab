# Copy to .env for local overrides. Every value here is the default that
# `just dev` already uses, so the file is optional.
#
# Nothing in this file is a secret: these are the credentials of the local
# containers in infra/compose.yaml. Production values live in the systemd
# environment file rendered by Ansible, never in the repository.

# development | production. Unset means production: reflection off, request
# logging off, proxy headers trusted.
DOELAB_ENV=development

DATABASE_URL=postgres://doelab:doelab@localhost:5436/doelab?sslmode=disable
HOST=127.0.0.1
PORT=3100

# S3-compatible object store: Versity Gateway locally, DigitalOcean Spaces in
# production. The API creates the bucket at startup in development.
S3_ENDPOINT=http://localhost:9200
S3_REGION=us-east-1
S3_BUCKET=doelab
S3_ACCESS_KEY_ID=doelab
S3_SECRET_ACCESS_KEY=doelab-dev-only
# true for the local gateway (http://host/bucket/key), false for Spaces.
S3_PATH_STYLE=true

# Bearer tokens, one per scope. Reads are public; these gate writes.
#   engine:   publish envelopes, start and complete runs
#   operator: backstop, config, site and device changes
#   device:   subscribe and ingest. The token of a device is
#             HMAC-SHA256(DEVICE_TOKEN_SECRET, nmi), so there is one per NMI
#             and nothing to store.
ENGINE_TOKEN=dev-engine-token
OPERATOR_TOKEN=dev-operator-token
DEVICE_TOKEN_SECRET=dev-device-secret

# Where the engine and the simulator find the API.
API_URL=http://localhost:3100

# Calls a second, and in a burst, that one client address may make. A stream
# counts once, when it opens. A load test raises both.
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=400

# How much history is kept, in days of feeder time. With the demo clock at
# 60 a day of feeder time is 24 minutes, so these bound the database's size.
RETENTION_READINGS_DAYS=14
RETENTION_ENVELOPES_DAYS=30
RETENTION_ALERTS_DAYS=90

# Observability. /metrics is served on METRICS_ADDR (loopback only). Traces go
# to OTLP when the endpoint is set, and to stdout in development otherwise.
METRICS_ADDR=127.0.0.1:9464
OTEL_EXPORTER_OTLP_ENDPOINT=

# The assistant is off unless a key is set. It answers questions with a
# language model, which costs money: the budget is what a UTC day of answers
# may cost, in US dollars.
ANTHROPIC_API_KEY=
ASSISTANT_DAILY_BUDGET_USD=2
